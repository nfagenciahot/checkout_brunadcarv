# Painel
PANEL_USER=admin
PANEL_PASSWORD=troque-esta-senha
PANEL_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# GitHub - necessário para o /panel salvar config e mídias em produção
GITHUB_TOKEN=
GITHUB_OWNER=nfagenciahot
GITHUB_REPO=checkout_brunadcarv
GITHUB_BRANCH=main

# Site
SITE_URL=https://brunadcarv.online

# OmegaPay
OMEGAPAY_PUBLIC_KEY=
OMEGAPAY_SECRET_KEY=
# Use o seu próprio CPF/documento aceito pela sua conta OmegaPay
OMEGAPAY_DOCUMENT=
# Opcional. Se vazio, o site usa SITE_URL + /api/webhooks/omegapay
OMEGAPAY_CALLBACK_URL=

# Persistência obrigatória na Vercel
REDIS_URL=

# Telegram - configure um token novo antes de produção
TELEGRAM_BOT_TOKEN=

# Vercel Blob Private
# Conecte o Blob ao projeto em Storage. Em projetos novos a autenticação OIDC é automática.
# Em stores antigos, a Vercel pode fornecer BLOB_READ_WRITE_TOKEN automaticamente.
